# 복사해서 application-local.yml 로 만든 뒤 쓴다. (application-local.yml 은 git에 안 올라감)
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/motdahan?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: motdahan
    password: motdahan-local
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

jwt:
  # 로컬 전용 값. 32자 이상이면 아무거나 됨
  secret: local-only-secret-change-me-0123456789abcdef

cors:
  allowed-origins:
    - http://localhost:3000
    - http://localhost:5173
