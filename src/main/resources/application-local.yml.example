# 복사해서 application-local.yml 로 만든 뒤 쓴다. (application-local.yml 은 git에 안 올라감)
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/toro?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: toro
    password: toro-local
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

jwt:
  # 로컬 전용 값. 32자 이상이면 아무거나 됨
  secret: local-only-secret-change-me-0123456789abcdef

cors:
  # 쉼표로 구분 (@Value로 읽어서 YAML 목록 형식은 안 됨)
  allowed-origins: http://localhost:3000,http://localhost:5173
